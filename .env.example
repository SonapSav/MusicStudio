# Copy this file to ".env" and fill in your real key.
# Get a key at https://openrouter.ai/keys

OPENROUTER_API_KEY=sk-or-your-key-here

# Optional — port the local server listens on (code default is 3000;
# this project uses 3012 to avoid clashing with other local dev servers)
PORT=3012

# Optional — sent to OpenRouter for attribution/rankings (safe to leave as-is)
APP_TITLE=MusicStudio
APP_URL=http://localhost:3012

# Optional — models used by the AI helpers (any OpenRouter chat model)
LYRICS_MODEL=anthropic/claude-sonnet-5
ENHANCE_MODEL=anthropic/claude-sonnet-5
